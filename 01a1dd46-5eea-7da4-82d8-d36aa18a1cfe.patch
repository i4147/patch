index 0000000..05c031b
--- /dev/null
+++ b/tools/migrate_argparse_to_typer.py
@@ -0,0 +1,334 @@
+#!/usr/bin/env python3
+"""Inventory and migrate root-level argparse CLIs to Typer in reviewable batches.
+
+The helper inventories before editing and processes every matching root-level
+Python file in batches; ``--batch-size`` controls the batch width, not the total
+number of files visited.
+"""
+from __future__ import annotations
+
+import argparse
+import ast
+import io
+import json
+import tokenize
+from collections import Counter
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+
+
+class ArgparseInventory(ast.NodeVisitor):
+    def __init__(self) -> None:
+        self.imports: list[int] = []
+        self.parser_calls: list[int] = []
+        self.add_argument_calls: list[int] = []
+        self.subparser_calls: list[int] = []
+        self.parse_calls: list[int] = []
+        self.parse_known_calls: list[int] = []
+        self.custom_action_refs: list[int] = []
+        self.argparse_refs: list[int] = []
+        self.argument_actions: Counter[str] = Counter()
+        self.option_actions: Counter[str] = Counter()
+        self.positional_actions: Counter[str] = Counter()
+        self.argument_types: Counter[str] = Counter()
+        self.argument_keywords: Counter[str] = Counter()
+        self.argument_nargs: Counter[str] = Counter()
+        self.option_nargs: Counter[str] = Counter()
+        self.positional_nargs: Counter[str] = Counter()
+        self.argument_methods: Counter[str] = Counter()
+        self.functions: list[str] = []
+
+    def visit_Import(self, node: ast.Import) -> None:
+        if any(alias.name == "argparse" for alias in node.names):
+            self.imports.append(node.lineno)
+        self.generic_visit(node)
+
+    def visit_ImportFrom(self, node: ast.ImportFrom) -> None:
+        if node.module == "argparse":
+            self.imports.append(node.lineno)
+        self.generic_visit(node)
+
+    def visit_FunctionDef(self, node: ast.FunctionDef) -> None:
+        self.functions.append(node.name)
+        self.generic_visit(node)
+
+    visit_AsyncFunctionDef = visit_FunctionDef
+
+    def visit_Call(self, node: ast.Call) -> None:
+        func = node.func
+        attr = func.attr if isinstance(func, ast.Attribute) else ""
+        parser_methods = {
+            "ArgumentParser",
+            "add_argument",
+            "add_subparsers",
+            "add_parser",
+            "set_defaults",
+            "add_argument_group",
+            "add_mutually_exclusive_group",
+            "parse_args",
+            "parse_known_args",
+            "parse_intermixed_args",
+            "format_help",
+            "print_help",
+            "format_usage",
+            "print_usage",
+            "error",
+            "exit",
+        }
+        if attr in parser_methods:
+            self.argument_methods[attr] += 1
+        if attr == "ArgumentParser":
+            self.parser_calls.append(node.lineno)
+        elif attr == "add_argument":
+            self.add_argument_calls.append(node.lineno)
+            keywords = {keyword.arg: keyword.value for keyword in node.keywords if keyword.arg}
+            self.argument_keywords.update(keywords.keys())
+            action = keywords.get("action")
+            action_text = ast.unparse(action) if action is not None else "store"
+            self.argument_actions[action_text] += 1
+            is_option = bool(
+                node.args
+                and isinstance(node.args[0], ast.Constant)
+                and isinstance(node.args[0].value, str)
+                and node.args[0].value.startswith("-")
+            )
+            (self.option_actions if is_option else self.positional_actions)[action_text] += 1
+            type_node = keywords.get("type")
+            if type_node is not None:
+                self.argument_types[ast.unparse(type_node)] += 1
+            nargs_node = keywords.get("nargs")
+            if nargs_node is not None:
+                nargs_text = ast.unparse(nargs_node)
+                self.argument_nargs[nargs_text] += 1
+                (self.option_nargs if is_option else self.positional_nargs)[nargs_text] += 1
+        elif attr == "add_subparsers":
+            self.subparser_calls.append(node.lineno)
+        elif attr in {"parse_args", "parse_intermixed_args"}:
+            self.parse_calls.append(node.lineno)
+        elif attr == "parse_known_args":
+            self.parse_known_calls.append(node.lineno)
+        self.generic_visit(node)
+
+    def visit_Attribute(self, node: ast.Attribute) -> None:
+        if node.attr in {
+            "Action",
+            "Namespace",
+            "FileType",
+            "RawDescriptionHelpFormatter",
+            "RawTextHelpFormatter",
+        }:
+            self.custom_action_refs.append(node.lineno)
+        if isinstance(node.value, ast.Name) and node.value.id == "argparse":
+            self.argparse_refs.append(node.lineno)
+        self.generic_visit(node)
+
+
+def inventory() -> list[dict[str, object]]:
+    rows: list[dict[str, object]] = []
+    for path in sorted(ROOT.glob("*.py")):
+        source = path.read_text(encoding="utf-8")
+        try:
+            tree = ast.parse(source, filename=str(path))
+        except SyntaxError as exc:
+            if "argparse" not in source:
+                continue
+            rows.append({"file": path.name, "syntax_error": f"{exc.msg} at {exc.lineno}"})
+            continue
+        scan = ArgparseInventory()
+        scan.visit(tree)
+        if not scan.imports:
+            continue
+        rows.append(
+            {
+                "file": path.name,
+                "lines": len(source.splitlines()),
+                "parser_calls": len(scan.parser_calls),
+                "add_argument_calls": len(scan.add_argument_calls),
+                "subparser_calls": len(scan.subparser_calls),
+                "parse_calls": len(scan.parse_calls),
+                "parse_known_calls": len(scan.parse_known_calls),
+                "argparse_refs": len(scan.argparse_refs),
+                "special_refs": len(scan.custom_action_refs),
+                "actions": dict(scan.argument_actions),
+                "option_actions": dict(scan.option_actions),
+                "positional_actions": dict(scan.positional_actions),
+                "types": dict(scan.argument_types),
+                "keywords": dict(scan.argument_keywords),
+                "nargs": dict(scan.argument_nargs),
+                "option_nargs": dict(scan.option_nargs),
+                "positional_nargs": dict(scan.positional_nargs),
+                "methods": dict(scan.argument_methods),
+                "functions": scan.functions,
+            }
+        )
+    return rows
+
+
+def _replacement_import(node: ast.Import | ast.ImportFrom, lines: list[str]) -> str:
+    original = "".join(lines[node.lineno - 1 : node.end_lineno])
+    indent = original[: len(original) - len(original.lstrip())]
+    if isinstance(node, ast.Import):
+        replacement: list[str] = []
+        for alias in node.names:
+            if alias.name == "argparse":
+                suffix = f" as {alias.asname}" if alias.asname else ""
+                replacement.append(f"{indent}from tools import typer_cli{suffix}")
+            else:
+                suffix = f" as {alias.asname}" if alias.asname else ""
+                replacement.append(f"{indent}import {alias.name}{suffix}")
+        return "\n".join(replacement) + ("\n" if original.endswith("\n") else "")
+
+    imported: list[str] = []
+    for alias in node.names:
+        name = alias.name
+        bound_name = alias.asname
+        if name == "ArgumentParser":
+            name = "TyperParser"
+            bound_name = bound_name or "ArgumentParser"
+        elif name == "_MutuallyExclusiveGroup":
+            name = "MutuallyExclusiveGroup"
+            bound_name = bound_name or "_MutuallyExclusiveGroup"
+        part = name + (f" as {bound_name}" if bound_name else "")
+        imported.append(part)
+    comment = ""
+    if original.rstrip().endswith(")") and "(" in original:
+        # Preserve a readable multiline form for future direct imports.
+        rendered = ",\n".join(f"{indent}    {item}" for item in imported)
+        return f"{indent}from tools.typer_cli import (\n{rendered}\n{indent})\n"
+    return f"{indent}from tools.typer_cli import {', '.join(imported)}\n"
+
+
+def migrate_source(source: str, filename: str) -> tuple[str, int]:
+    """Replace argparse imports/references without touching strings/comments."""
+    tree = ast.parse(source, filename=filename)
+    lines = source.splitlines(keepends=True)
+    imports = [
+        node
+        for node in ast.walk(tree)
+        if isinstance(node, (ast.Import, ast.ImportFrom))
+        and (
+            isinstance(node, ast.Import)
+            and any(alias.name == "argparse" for alias in node.names)
+            or isinstance(node, ast.ImportFrom)
+            and node.module == "argparse"
+        )
+    ]
+    for node in sorted(imports, key=lambda item: item.lineno, reverse=True):
+        start = node.lineno - 1
+        end = node.end_lineno or node.lineno
+        lines[start:end] = [_replacement_import(node, lines)]
+    migrated = "".join(lines)
+
+    # Change only Python NAME tokens: comments, docstrings, and user-facing
+    # prose that mentions argparse are left untouched.
+    migrated_lines = migrated.splitlines(keepends=True)
+    offsets: list[int] = []
+    running = 0
+    for line in migrated_lines:
+        offsets.append(running)
+        running += len(line)
+    edits: list[tuple[int, int]] = []
+    for token in tokenize.generate_tokens(io.StringIO(migrated).readline):
+        if token.type == tokenize.NAME and token.string == "argparse":
+            start = offsets[token.start[0] - 1] + token.start[1]
+            end = offsets[token.end[0] - 1] + token.end[1]
+            edits.append((start, end))
+    for start, end in reversed(edits):
+        migrated = migrated[:start] + "typer_cli" + migrated[end:]
+    migrated = migrated.replace("typer_cli.ArgumentParser", "typer_cli.TyperParser")
+    migrated = migrated.replace("typer_cli._MutuallyExclusiveGroup", "typer_cli.MutuallyExclusiveGroup")
+    ast.parse(migrated, filename=filename)
+    return migrated, len(imports)
+
+
+def _summary(rows: list[dict[str, object]], *, features: bool) -> None:
+    counts = Counter()
+    for row in rows:
+        if "syntax_error" in row:
+            counts["syntax errors"] += 1
+            continue
+        for key in ("parser_calls", "add_argument_calls", "subparser_calls", "parse_calls", "parse_known_calls"):
+            counts[key] += int(row[key])
+    print(f"Root-level argparse files: {len(rows)}")
+    print("Totals: " + ", ".join(f"{key}={value}" for key, value in counts.items()))
+    if features:
+        for field in (
+            "option_actions",
+            "positional_actions",
+            "types",
+            "keywords",
+            "option_nargs",
+            "positional_nargs",
+            "methods",
+        ):
+            features_by_name: Counter[str] = Counter()
+            for row in rows:
+                features_by_name.update(row.get(field, {}))
+            print(f"\n{field.replace('_', ' ').title()}:")
+            for name, count in features_by_name.most_common():
+                print(f"  {count:4d} {name}")
+
+
+def apply_migration(rows: list[dict[str, object]], batch_size: int) -> tuple[int, int]:
+    files = [ROOT / str(row["file"]) for row in rows if "syntax_error" not in row]
+    size = max(batch_size, 1)
+    changed = 0
+    failed = 0
+    for offset in range(0, len(files), size):
+        batch = files[offset : offset + size]
+        batch_changed = 0
+        for path in batch:
+            try:
+                before = path.read_text(encoding="utf-8")
+                after, _ = migrate_source(before, path.name)
+                if after != before:
+                    path.write_text(after, encoding="utf-8")
+                    changed += 1
+                    batch_changed += 1
+            except (OSError, SyntaxError, tokenize.TokenError, UnicodeError) as exc:
+                failed += 1
+                print(f"  ERROR {path.name}: {exc}")
+        print(
+            f"Batch {offset // size + 1}: processed {len(batch)} files; "
+            f"migrated {batch_changed}."
+        )
+    return changed, failed
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--json", action="store_true", help="print full inventory as JSON")
+    parser.add_argument("--features", action="store_true", help="summarize argument actions, types, nargs, and parser methods")
+    parser.add_argument("--summary-only", action="store_true", help="omit per-file batch listings")
+    parser.add_argument("--apply", action="store_true", help="migrate every root-level argparse file")
+    parser.add_argument("--batch-size", type=int, default=25, help="files per processing batch; all batches are processed")
+    args = parser.parse_args()
+    rows = inventory()
+    if args.json:
+        print(json.dumps(rows, indent=2))
+        return 0
+    _summary(rows, features=args.features)
+    if args.apply:
+        changed, failed = apply_migration(rows, args.batch_size)
+        print(f"\nMigration result: changed={changed}, failed={failed}, scanned={len(rows)}")
+        return 1 if failed else 0
+    if args.summary_only:
+        return 0
+    size = max(args.batch_size, 1)
+    for offset in range(0, len(rows), size):
+        batch = rows[offset : offset + size]
+        print(f"\nBatch {offset // size + 1} ({len(batch)} files):")
+        print("  " + ", ".join(str(row["file"]) for row in batch))
+        complex_files = [
+            row["file"]
+            for row in batch
+            if row.get("subparser_calls") or row.get("parse_known_calls") or row.get("special_refs")
+        ]
+        if complex_files:
+            print("  Review carefully: " + ", ".join(str(name) for name in complex_files))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
