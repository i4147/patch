+"""Typer-backed compatibility layer for the repository's command-line scripts.
+
+Root scripts used argparse's declarative ``add_argument`` API extensively. This
+module lets those declarations be translated into a real Typer application at
+runtime, so the scripts can move off the stdlib parser without changing their
+existing command-line spellings or their ``Namespace``-based business logic.
+
+New CLIs should use ``typer.Typer`` and annotated command functions directly;
+this adapter exists only to make the repository-wide migration incremental and
+behavior-preserving.
+"""
+from __future__ import annotations
+
+import inspect
+import io
+import os
+import re
+import sys
+from dataclasses import dataclass, field
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any, Callable, Optional, Sequence
+
+try:
+    import typer
+except ImportError as exc:  # pragma: no cover - depends on the runtime environment
+    raise ImportError(
+        "The migrated command-line scripts require Typer. Install it with "
+        "`python -m pip install -r requirements-typer.txt`."
+    ) from exc
+
+try:
+    import click as _click
+except ImportError:  # Typer 0.29+ bundles its Click-compatible core.
+    _click = typer._click
+
+
+class Namespace(SimpleNamespace):
+    """Namespace equivalent returned by migrated script parsers."""
+
+    def __repr__(self) -> str:
+        body = ", ".join(f"{key}={value!r}" for key, value in vars(self).items())
+        return f"Namespace({body})"
+
+
+class ArgumentTypeError(ValueError):
+    """Type-conversion error retained for existing custom converters."""
+
+
+class BooleanOptionalAction:
+    """Marker recognized by :meth:`TyperParser.add_argument`."""
+
+
+class RawDescriptionHelpFormatter:
+    """Compatibility marker; Typer renders help with its own formatter."""
+
+
+class RawTextHelpFormatter(RawDescriptionHelpFormatter):
+    """Compatibility marker; Typer renders help with its own formatter."""
+
+
+class ArgumentDefaultsHelpFormatter:
+    """Compatibility marker; default values are shown when requested."""
+
+
+class _Sentinel:
+    def __init__(self, name: str) -> None:
+        self.name = name
+
+    def __repr__(self) -> str:
+        return self.name
+
+
+SUPPRESS = _Sentinel("SUPPRESS")
+REMAINDER = _Sentinel("REMAINDER")
+
+
+class FileType:
+    """Small ``argparse.FileType`` replacement for existing file parameters."""
+
+    def __init__(self, mode: str = "r", bufsize: int = -1, encoding: str | None = None, errors: str | None = None) -> None:
+        self.mode = mode
+        self.bufsize = bufsize
+        self.encoding = encoding
+        self.errors = errors
+
+    def __call__(self, value: str | os.PathLike[str] | Any) -> Any:
+        if hasattr(value, "read") or hasattr(value, "write"):
+            return value
+        filename = os.fspath(value)
+        if filename == "-":
+            return sys.stdin if "r" in self.mode else sys.stdout
+        kwargs: dict[str, Any] = {}
+        if self.encoding is not None:
+            kwargs["encoding"] = self.encoding
+        if self.errors is not None:
+            kwargs["errors"] = self.errors
+        return open(filename, self.mode, self.bufsize, **kwargs)
+
+    def __repr__(self) -> str:
+        return f"FileType({self.mode!r}, encoding={self.encoding!r})"
+
+
+@dataclass(slots=True)
+class _Argument:
+    names: tuple[str, ...]
+    dest: str
+    kwargs: dict[str, Any]
+    index: int
+    panel: str | None = None
+    exclusive_group: _MutuallyExclusiveGroup | None = None
+    default_explicit: bool = False
+    prefix_chars: str = "-"
+
+    @property
+    def is_option(self) -> bool:
+        return bool(self.names and self.names[0] and self.names[0][0] in self.prefix_chars)
+
+    @property
+    def action(self) -> Any:
+        return self.kwargs.get("action", "store")
+
+    @property
+    def nargs(self) -> Any:
+        value = self.kwargs.get("nargs")
+        return 1 if value is None else value
+
+
+class _ArgumentGroup:
+    def __init__(self, parser: TyperParser, title: str | None, description: str | None = None) -> None:
+        self.parser = parser
+        self.title = title
+        self.description = description
+
+    def add_argument(self, *names: str, **kwargs: Any) -> _Argument:
+        return self.parser._add_argument(*names, _panel=self.title, **kwargs)
+
+
+class _MutuallyExclusiveGroup(_ArgumentGroup):
+    def __init__(self, parser: TyperParser, *, required: bool = False, title: str | None = None) -> None:
+        super().__init__(parser, title)
+        self.required = required
+        self.members: list[_Argument] = []
+
+    def add_argument(self, *names: str, **kwargs: Any) -> _Argument:
+        spec = self.parser._add_argument(*names, _exclusive_group=self, **kwargs)
+        self.members.append(spec)
+        return spec
+
+
+class _SubParsers:
+    def __init__(
+        self,
+        parser: TyperParser,
+        *,
+        dest: str | None = None,
+        required: bool = False,
+        title: str | None = None,
+        description: str | None = None,
+        metavar: str | None = None,
+        parser_class: type[TyperParser] | None = None,
+    ) -> None:
+        self.parser = parser
+        self.dest = dest
+        self.required = required
+        self.title = title
+        self.description = description
+        self.metavar = metavar
+        self.parser_class = parser_class or TyperParser
+        self.parsers: list[TyperParser] = []
+
+    def add_parser(self, name: str, **kwargs: Any) -> TyperParser:
+        child = self.parser_class(
+            prog=kwargs.get("prog") or f"{self.parser.prog} {name}".strip(),
+            description=kwargs.get("description"),
+            epilog=kwargs.get("epilog"),
+            formatter_class=kwargs.get("formatter_class"),
+            add_help=kwargs.get("add_help", True),
+            allow_abbrev=kwargs.get("allow_abbrev", True),
+        )
+        child._command_name = name
+        child._command_help = kwargs.get("help")
+        child._aliases = tuple(kwargs.get("aliases", ()))
+        child._parent = self.parser
+        child._parent_subparsers = self
+        self.parsers.append(child)
+        return child
+
+
+class TyperParser:
+    """Collect parser-style declarations and compile them to a Typer app."""
+
+    def __init__(
+        self,
+        prog: str | None = None,
+        usage: str | None = None,
+        description: str | None = None,
+        epilog: str | None = None,
+        parents: Sequence[TyperParser] = (),
+        formatter_class: type[Any] | None = None,
+        prefix_chars: str = "-",
+        fromfile_prefix_chars: str | None = None,
+        argument_default: Any = None,
+        conflict_handler: str = "error",
+        add_help: bool = True,
+        allow_abbrev: bool = True,
+        exit_on_error: bool = True,
+        **_: Any,
+    ) -> None:
+        self.prog = prog or Path(sys.argv[0]).name
+        self.usage = usage
+        self.description = description
+        self.epilog = epilog
+        self.formatter_class = formatter_class
+        self.prefix_chars = prefix_chars
+        self.fromfile_prefix_chars = fromfile_prefix_chars
+        self.argument_default = argument_default
+        self.conflict_handler = conflict_handler
+        self.add_help = add_help
+        self.allow_abbrev = allow_abbrev
+        self.exit_on_error = exit_on_error
+        self._arguments: list[_Argument] = []
+        self._defaults: dict[str, Any] = {}
+        self._subparsers: _SubParsers | None = None
+        self._parent: TyperParser | None = None
+        self._parent_subparsers: _SubParsers | None = None
+        self._command_name: str | None = None
+        self._command_help: str | None = None
+        self._aliases: tuple[str, ...] = ()
+        self._parse_known = False
+        self._last_namespace: Namespace | None = None
+        for parent in parents:
+            self._arguments.extend(parent._arguments)
+            self._defaults.update(parent._defaults)
+
+    def _add_argument(
+        self,
+        *names: str,
+        _panel: str | None = None,
+        _exclusive_group: _MutuallyExclusiveGroup | None = None,
+        **kwargs: Any,
+    ) -> _Argument:
+        if not names:
+            raise TypeError("add_argument() requires at least one name")
+        name_values = tuple(str(name) for name in names)
+        dest = kwargs.get("dest")
+        if dest is None:
+            if name_values[0].startswith(self.prefix_chars):
+                candidate = next((name for name in reversed(name_values) if name.startswith(self.prefix_chars * 2)), name_values[-1])
+                dest = candidate.lstrip(self.prefix_chars).replace("-", "_")
+            else:
+                dest = name_values[0]
+        kwargs["dest"] = dest
+        default_explicit = "default" in kwargs
+        if "default" not in kwargs:
+            if self.argument_default is not None:
+                kwargs["default"] = self.argument_default
+            else:
+                action = kwargs.get("action", "store")
+                if action == "store_true" or action is BooleanOptionalAction:
+                    kwargs["default"] = False
+                elif action == "store_false":
+                    kwargs["default"] = True
+                elif action == "version":
+                    kwargs["default"] = SUPPRESS
+                else:
+                    kwargs["default"] = None
+        spec = _Argument(
+            name_values,
+            str(dest),
+            dict(kwargs),
+            len(self._arguments),
+            _panel,
+            _exclusive_group,
+            default_explicit,
+            self.prefix_chars,
+        )
+        self._arguments.append(spec)
+        return spec
+
+    def add_argument(self, *names: str, **kwargs: Any) -> _Argument:
+        return self._add_argument(*names, **kwargs)
+
+    def add_argument_group(self, title: str | None, description: str | None = None, **_: Any) -> _ArgumentGroup:
+        return _ArgumentGroup(self, title, description)
+
+    def add_mutually_exclusive_group(self, *, required: bool = False, **_: Any) -> _MutuallyExclusiveGroup:
+        return _MutuallyExclusiveGroup(self, required=required)
+
+    def add_subparsers(self, **kwargs: Any) -> _SubParsers:
+        if self._subparsers is not None:
+            raise ValueError("only one add_subparsers() call is supported per parser")
+        self._subparsers = _SubParsers(self, **kwargs)
+        return self._subparsers
+
+    def set_defaults(self, **kwargs: Any) -> None:
+        self._defaults.update(kwargs)
+
+    def parse_args(self, args: Sequence[str] | None = None, namespace: Namespace | None = None) -> Namespace:
+        result, _ = self._parse(args, namespace, known=False)
+        return result
+
+    def parse_known_args(
+        self, args: Sequence[str] | None = None, namespace: Namespace | None = None
+    ) -> tuple[Namespace, list[str]]:
+        return self._parse(args, namespace, known=True)
+
+    def parse_intermixed_args(self, args: Sequence[str] | None = None, namespace: Namespace | None = None) -> Namespace:
+        result, _ = self._parse(args, namespace, known=False)
+        return result
+
+    def _parse(
+        self,
+        args: Sequence[str] | None,
+        namespace: Namespace | None,
+        *,
+        known: bool,
+    ) -> tuple[Namespace, list[str]]:
+        supplied = list(sys.argv[1:] if args is None else args)
+        app, state = _compile_app(self, known=known)
+        normalized = _normalize_variable_options(self, supplied)
+        try:
+            app(args=normalized, standalone_mode=False, prog_name=self.prog)
+        except SystemExit:
+            raise
+        except typer.Exit as exc:
+            raise SystemExit(exc.exit_code) from None
+        except _click.ClickException as exc:
+            exc.show(file=sys.stderr)
+            raise SystemExit(exc.exit_code) from None
+        if _help_requested(self, supplied) or _version_requested(self, supplied):
+            raise SystemExit(0)
+        if not state["chain"]:
+            state["chain"] = [self]
+        chain: list[TyperParser] = state["chain"]
+        for current in chain:
+            if current._subparsers and current._subparsers.required and id(current) not in state["commands"]:
+                current.error("too few arguments")
+        values: dict[str, Any] = {}
+        for current in chain:
+            values.update({key: val for key, val in current._defaults.items() if val is not SUPPRESS})
+            values.update(state["values"].get(id(current), {}))
+            subparsers = current._subparsers
+            if subparsers and subparsers.dest and id(current) in state["commands"]:
+                values[subparsers.dest] = state["commands"][id(current)]
+        if namespace is None:
+            result = Namespace(**values)
+        else:
+            vars(namespace).update(values)
+            result = namespace
+        self._last_namespace = result
+        unknown = list(state.get("unknown", []))
+        return result, unknown
+
+    def error(self, message: str) -> None:
+        print(f"{self.prog}: error: {message}", file=sys.stderr)
+        raise SystemExit(2)
+
+    def exit(self, status: int = 0, message: str | None = None) -> None:
+        if message:
+            print(message, end="", file=sys.stderr if status else sys.stdout)
+        raise SystemExit(status)
+
+    def format_help(self) -> str:
+        app, _ = _compile_app(self, known=False)
+        command = typer.main.get_command(app)
+        ctx = command.make_context(self.prog, [], resilient_parsing=True)
+        try:
+            return command.get_help(ctx)
+        finally:
+            ctx.close()
+
+    def print_help(self, file: Any = None) -> None:
+        print(self.format_help(), file=file or sys.stdout)
+
+    def format_usage(self) -> str:
+        text = self.format_help()
+        return (text.splitlines()[0] if text else f"Usage: {self.prog}") + "\n"
+
+    def print_usage(self, file: Any = None) -> None:
+        print(self.format_usage(), file=file or sys.stdout, end="")
+
+
+# Keep common import spellings working while the scripts are migrated in batches.
+ArgumentParser = TyperParser
+MutuallyExclusiveGroup = _MutuallyExclusiveGroup
+
+
+# Typer has used Click internally for years. The dynamic application below uses
+# only Typer's public decorators and parameter metadata, not argparse parsing.
+def _option_declarations(spec: _Argument) -> list[str]:
+    action = spec.action
+    if action is BooleanOptionalAction:
+        long_names = [name for name in spec.names if name.startswith("--")]
+        short_names = [name for name in spec.names if name.startswith("-") and not name.startswith("--")]
+        decls: list[str] = []
+        if long_names:
+            primary = long_names[0]
+            decls.append(f"{primary}/{primary[:2]}no-{primary[2:]}")
+            decls.extend(name for name in long_names[1:] if name != primary)
+        decls.extend(short_names)
+        return decls
+    return list(spec.names)
+
+
+def _action_name(spec: _Argument) -> str:
+    action = spec.action
+    if action is BooleanOptionalAction:
+        return "boolean_optional"
+    if isinstance(action, str):
+        return action
+    return getattr(action, "__name__", "store")
+
+
+def _signature_for_parser(parser: TyperParser, state: dict[str, Any]) -> Callable[..., Any]:
+    specs = parser._arguments
+    signature_params: list[inspect.Parameter] = [
+        inspect.Parameter("ctx", inspect.Parameter.KEYWORD_ONLY, annotation=typer.Context)
+    ]
+    annotations: dict[str, Any] = {"ctx": typer.Context}
+    param_names: dict[int, str] = {}
+    for spec in specs:
+        name = f"_typer_arg_{spec.index}"
+        param_names[spec.index] = name
+        action = _action_name(spec)
+        nargs = spec.nargs
+        default = spec.kwargs.get("default", None)
+        is_flag_action = action in {"store_true", "store_false", "store_const", "version", "boolean_optional"}
+        if action == "count":
+            annotation: Any = int
+            info = _typer_option(spec, name, 0 if default is None else default, count=True)
+        elif is_flag_action:
+            if action in {"store_const", "version"}:
+                annotation = bool
+                info = _typer_option(
+                    spec,
+                    name,
+                    False,
+                    is_flag=True,
+                    flag_value=True,
+                    is_eager=action == "version",
+                    callback=_version_callback(spec) if action == "version" else None,
+                )
+            elif action == "store_true":
+                annotation = bool
+                info = _typer_option(spec, name, bool(default), is_flag=True, flag_value=True)
+            elif action == "store_false":
+                annotation = bool
+                info = _typer_option(spec, name, bool(default), is_flag=True, flag_value=False)
+            else:
+                annotation = bool
+                info = _typer_option(spec, name, bool(default), is_flag=True)
+        elif spec.is_option and (nargs in {"*", "+", 2} or action == "append"):
+            annotation = list[str]
+            option_default: Any = ... if spec.kwargs.get("required", False) else []
+            info = _typer_option(spec, name, option_default)
+        elif spec.is_option:
+            annotation = Optional[str] if (default is None or nargs == "?") else str
+            option_default = ... if spec.kwargs.get("required", False) else _wire_value(default)
+            info = _typer_option(spec, name, option_default)
+        else:
+            if nargs in {"*", "+", REMAINDER}:
+                annotation = list[str]
+                arg_default = ... if nargs == "+" else None
+            elif nargs == 2:
+                annotation = tuple[str, str]
+                arg_default = ... if spec.kwargs.get("required", False) else _wire_value(default)
+            else:
+                annotation = Optional[str] if default is None or nargs == "?" else str
+                positional_is_required = nargs == 1
+                arg_default = ... if positional_is_required or spec.kwargs.get("required", False) else _wire_value(default)
+            info = _typer_argument(spec, name, arg_default)
+        if spec.is_option:
+            if not (isinstance(annotation, type) and annotation is bool) and action not in {"count"}:
+                info = _with_option_nargs(info, spec)
+        signature_params.append(
+            inspect.Parameter(name, inspect.Parameter.KEYWORD_ONLY, default=info, annotation=annotation)
+        )
+        annotations[name] = annotation
+
+    def callback(**values: Any) -> None:
+        ctx = values.get("ctx")
+        shared_values: dict[str, Any] = {}
+        provided: dict[int, bool] = {}
+        for spec in specs:
+            param_name = param_names[spec.index]
+            raw = values.get(param_name)
+            source_is_cli = _is_command_line_value(ctx, param_name)
+            provided[spec.index] = source_is_cli
+            _apply_spec(shared_values, spec, raw, source_is_cli, ctx)
+        _validate_exclusive_groups(parser, specs, shared_values, provided, ctx)
+        state["values"][id(parser)] = shared_values
+        if parser._parent_subparsers is not None:
+            ctx_name = getattr(ctx, "info_name", None)
+            state["commands"][id(parser._parent)] = ctx_name or parser._command_name or ""
+        state["chain"].append(parser)
+        if parser._subparsers is None and ctx is not None:
+            state["unknown"] = list(getattr(ctx, "args", ()))
+
+    callback.__name__ = f"_typer_{parser._command_name or 'main'}_{id(parser):x}"
+    callback.__annotations__ = annotations
+    callback.__signature__ = inspect.Signature(signature_params)  # type: ignore[attr-defined]
+    return callback
+
+
+def _typer_option(
+    spec: _Argument,
+    param_name: str,
+    default: Any,
+    *,
+    is_flag: bool | None = None,
+    flag_value: Any = None,
+    count: bool = False,
+    is_eager: bool = False,
+    callback: Callable[..., Any] | None = None,
+) -> Any:
+    kwargs: dict[str, Any] = {
+        "help": _help_text(spec),
+        "metavar": _metavar(spec),
+        "is_flag": is_flag,
+        "flag_value": flag_value,
+        "count": count,
+        "is_eager": is_eager,
+        "callback": callback,
+        "show_default": _show_default(spec),
+        "rich_help_panel": spec.panel,
+        "hidden": spec.kwargs.get("help") is SUPPRESS,
+    }
+    if spec.kwargs.get("required"):
+        default = ...
+    if spec.kwargs.get("choices") is not None:
+        choices = spec.kwargs["choices"]
+        if kwargs["help"]:
+            kwargs["help"] += f" (choices: {', '.join(map(str, choices))})"
+        else:
+            kwargs["help"] = f"choices: {', '.join(map(str, choices))}"
+    kwargs = {key: value for key, value in kwargs.items() if value is not None}
+    try:
+        return typer.Option(default, *_option_declarations(spec), **kwargs)
+    except TypeError:
+        kwargs.pop("rich_help_panel", None)
+        return typer.Option(default, *_option_declarations(spec), **kwargs)
+
+
+def _typer_argument(spec: _Argument, param_name: str, default: Any) -> Any:
+    kwargs: dict[str, Any] = {
+        "help": _help_text(spec),
+        "metavar": _metavar(spec),
+        "show_default": _show_default(spec),
+    }
+    try:
+        return typer.Argument(default, **kwargs)
+    except TypeError:
+        kwargs.pop("show_default", None)
+        return typer.Argument(default, **kwargs)
+
+
+def _with_option_nargs(info: Any, spec: _Argument) -> Any:
+    # ``Typer.Option`` exposes repeatable list parameters. The argv normalizer
+    # expands argparse-style nargs groups into repeated Typer options and the
+    # callback folds those values back into the original list/scalar shape.
+    # Fixed-size groups and optional-value options are handled by the same
+    # normalizer; the parameter declaration itself remains Typer-native.
+    return info
+
+
+def _help_text(spec: _Argument) -> str | None:
+    help_value = spec.kwargs.get("help")
+    return None if help_value is SUPPRESS else help_value
+
+
+def _metavar(spec: _Argument) -> str | None:
+    value = spec.kwargs.get("metavar")
+    if value is not None:
+        return str(value)
+    return spec.dest.upper() if not spec.is_option else None
+
+
+def _show_default(spec: _Argument) -> bool:
+    return isinstance(spec.kwargs.get("default"), (str, int, float, bool, Path)) and spec.kwargs.get("default") is not None
+
+
+def _wire_value(value: Any) -> Any:
+    if value is SUPPRESS:
+        return None
+    if isinstance(value, Path):
+        return str(value)
+    if isinstance(value, (str, int, float, bool)) or value is None:
+        return value
+    if isinstance(value, tuple):
+        return tuple(_wire_value(item) for item in value)
+    if isinstance(value, list):
+        return [_wire_value(item) for item in value]
+    return value
+
+
+def _version_callback(spec: _Argument) -> Callable[..., Any]:
+    def callback(ctx: Any, param: Any, value: Any) -> Any:
+        if value:
+            typer.echo(spec.kwargs.get("version", ""))
+            raise typer.Exit()
+        return value
+    return callback
+
+
+def _is_command_line_value(ctx: Any, name: str) -> bool:
+    if ctx is None or not hasattr(ctx, "get_parameter_source"):
+        return False
+    try:
+        source = ctx.get_parameter_source(name)
+    except Exception:
+        return False
+    return getattr(source, "name", str(source)).upper().endswith("COMMANDLINE")
+
+
+def _apply_spec(
+    target: dict[str, Any],
+    spec: _Argument,
+    raw: Any,
+    supplied: bool,
+    ctx: Any,
+) -> None:
+    name = spec.dest
+    action = _action_name(spec)
+    default = spec.kwargs.get("default", None)
+    nargs = spec.nargs
+    if not supplied:
+        if default is SUPPRESS:
+            return
+        value = default
+        if nargs == "*" and not spec.is_option and not spec.default_explicit and value is None:
+            value = []
+        converter = spec.kwargs.get("type")
+        if isinstance(value, str) and converter not in (None, str) and action == "store":
+            try:
+                value = converter(value)
+            except Exception as exc:
+                _bad_parameter(ctx, spec, str(exc))
+        target[name] = value
+        return
+
+    if action == "version":
+        return
+    if action == "store_true":
+        target[name] = True
+        return
+    if action == "store_false":
+        target[name] = False
+        return
+    if action == "boolean_optional":
+        target[name] = bool(raw)
+        return
+    if action == "store_const":
+        target[name] = spec.kwargs.get("const")
+        return
+    if action == "count":
+        target[name] = int(raw or 0)
+        return
+
+    converter = spec.kwargs.get("type")
+    values = _raw_values(raw)
+    if spec.is_option and (nargs in {"*", "+", 2}):
+        groups = _split_groups(values)
+        if nargs == 2:
+            if not groups or len(groups[-1]) != 2:
+                _bad_parameter(ctx, spec, f"expected {spec.dest} to receive exactly 2 values")
+            parsed = [_convert_one(value, converter, ctx, spec) for value in groups[-1]]
+            value = parsed
+        elif action == "append":
+            value = [
+                [_convert_one(item, converter, ctx, spec) for item in group if item != _EMPTY_VALUE]
+                for group in groups
+            ]
+        else:
+            if not groups:
+                value = []
+            else:
+                value = [_convert_one(item, converter, ctx, spec) for item in groups[-1] if item != _EMPTY_VALUE]
+            if nargs == "+" and not value:
+                _bad_parameter(ctx, spec, f"expected at least one value for {spec.dest}")
+        _validate_choices(value, spec, ctx)
+        if action == "append":
+            base = default if isinstance(default, list) else []
+            target[name] = list(base) + value
+        else:
+            target[name] = value
+        return
+
+    if action == "append":
+        appended = [_convert_one(item, converter, ctx, spec) for item in values]
+        _validate_choices(appended, spec, ctx)
+        base = default if isinstance(default, list) else []
+        target[name] = list(base) + appended
+        return
+    if action == "store_const":
+        target[name] = spec.kwargs.get("const")
+        return
+
+    if nargs == "?" and isinstance(raw, str) and raw in {_OPTIONAL_NONE_VALUE, _OPTIONAL_CONST_VALUE}:
+        value = spec.kwargs.get("const")
+        if isinstance(value, str) and converter not in (None, str):
+            value = _convert_one(value, converter, ctx, spec)
+    elif nargs in {"*", "+", REMAINDER}:
+        value = [_convert_one(item, converter, ctx, spec) for item in values]
+        if nargs == "+" and not value:
+            _bad_parameter(ctx, spec, f"expected at least one value for {spec.dest}")
+    elif nargs == 2:
+        if len(values) != 2:
+            _bad_parameter(ctx, spec, f"expected {spec.dest} to receive exactly 2 values")
+        value = [_convert_one(item, converter, ctx, spec) for item in values]
+    else:
+        if isinstance(raw, (tuple, list)):
+            raw = raw[0] if raw else None
+        value = _convert_one(raw, converter, ctx, spec)
+    _validate_choices(value, spec, ctx)
+    target[name] = value
+
+
+def _raw_values(raw: Any) -> list[Any]:
+    if raw is None:
+        return []
+    if isinstance(raw, (list, tuple)):
+        return list(raw)
+    return [raw]
+
+
+_EMPTY_VALUE = "__TYPER_CLI_EMPTY_5F0C8D__"
+_GROUP_SEPARATOR = "__TYPER_CLI_GROUP_5F0C8D__"
+_OPTIONAL_NONE_VALUE = "__TYPER_CLI_OPTIONAL_NONE_5F0C8D__"
+_OPTIONAL_CONST_VALUE = "__TYPER_CLI_OPTIONAL_CONST_5F0C8D__"
+
+
+def _split_groups(values: list[Any]) -> list[list[Any]]:
+    groups: list[list[Any]] = []
+    current: list[Any] = []
+    for value in values:
+        if value == _GROUP_SEPARATOR:
+            groups.append(current)
+            current = []
+        else:
+            current.append(value)
+    if current or not groups:
+        groups.append(current)
+    return groups
+
+
+def _convert_one(value: Any, converter: Any, ctx: Any, spec: _Argument) -> Any:
+    if value == _EMPTY_VALUE:
+        return value
+    if value == _OPTIONAL_NONE_VALUE:
+        return None
+    if value == _OPTIONAL_CONST_VALUE:
+        value = spec.kwargs.get("const")
+    if converter is None or converter is str:
+        converted = value
+    elif isinstance(converter, FileType):
+        try:
+            converted = converter(value)
+        except (OSError, ValueError) as exc:
+            _bad_parameter(ctx, spec, str(exc))
+    else:
+        try:
+            converted = converter(value)
+        except (ArgumentTypeError, ValueError, TypeError, OSError) as exc:
+            _bad_parameter(ctx, spec, str(exc))
+    return converted
+
+
+def _validate_choices(value: Any, spec: _Argument, ctx: Any) -> None:
+    choices = spec.kwargs.get("choices")
+    if choices is None:
+        return
+    values: list[Any] = []
+    def flatten(item: Any) -> None:
+        if isinstance(item, (list, tuple)):
+            for nested in item:
+                flatten(nested)
+        else:
+            values.append(item)
+    flatten(value)
+    for item in values:
+        if item not in choices:
+            choices_text = ", ".join(map(str, choices))
+            _bad_parameter(ctx, spec, f"invalid choice: {item!r} (choose from {choices_text})")
+
+
+def _bad_parameter(ctx: Any, spec: _Argument, message: str) -> None:
+    try:
+        raise typer.BadParameter(message, param_hint=spec.names[-1] if spec.names else spec.dest)
+    except typer.BadParameter:
+        raise
+
+
+def _validate_exclusive_groups(
+    parser: TyperParser,
+    specs: list[_Argument],
+    values: dict[str, Any],
+    provided: dict[int, bool],
+    ctx: Any,
+) -> None:
+    groups = {spec.exclusive_group for spec in specs if spec.exclusive_group is not None}
+    for group in groups:
+        assert group is not None
+        selected = [spec for spec in group.members if provided.get(spec.index, False)]
+        if len(selected) > 1:
+            _bad_parameter(ctx, selected[-1], "arguments are mutually exclusive")
+        if group.required and not selected:
+            _bad_parameter(ctx, group.members[0] if group.members else _Argument((), "", {}, 0), "one of the arguments is required")
+
+
+def _new_app(parser: TyperParser, *, known: bool, is_group: bool) -> Any:
+    prefix = parser.prefix_chars[0] if parser.prefix_chars else "-"
+    context_settings = {
+        "ignore_unknown_options": known,
+        "allow_extra_args": known or is_group,
+        "help_option_names": [f"{prefix}h", f"{prefix}{prefix}help"] if parser.add_help else [],
+    }
+    kwargs = {
+        "name": parser.prog,
+        "help": parser.description,
+        "add_completion": False,
+        "no_args_is_help": False,
+        "invoke_without_command": True,
+        "context_settings": context_settings,
+        "rich_markup_mode": None,
+    }
+    try:
+        return typer.Typer(**kwargs, pretty_exceptions_enable=False)
+    except TypeError:
+        return typer.Typer(**kwargs)
+
+
+def _compile_app(
+    parser: TyperParser,
+    *,
+    known: bool,
+    state: dict[str, Any] | None = None,
+    is_root: bool = True,
+) -> tuple[Any, dict[str, Any]]:
+    if state is None:
+        state = {"chain": [], "values": {}, "commands": {}, "unknown": []}
+    app = _new_app(parser, known=known, is_group=parser._subparsers is not None or not is_root)
+    callback = _signature_for_parser(parser, state)
+    if parser._subparsers is None and is_root:
+        app.command()(callback)
+        return app, state
+    app.callback()(callback)
+    if parser._subparsers is not None:
+        for child in parser._subparsers.parsers:
+            names = (child._command_name or "", *child._aliases)
+            if child._subparsers is None:
+                child_callback = _signature_for_parser(child, state)
+                for command_name in names:
+                    app.command(name=command_name, help=child._command_help)(child_callback)
+            else:
+                child_app, _ = _compile_app(child, known=known, state=state, is_root=False)
+                for command_name in names:
+                    app.add_typer(child_app, name=command_name, help=child._command_help)
+    return app, state
+
+
+def _option_map(parser: TyperParser) -> dict[str, _Argument]:
+    result: dict[str, _Argument] = {}
+    def visit(current: TyperParser) -> None:
+        for spec in current._arguments:
+            if spec.is_option:
+                for name in spec.names:
+                    result[name] = spec
+        if current._subparsers:
+            for child in current._subparsers.parsers:
+                visit(child)
+    visit(parser)
+    return result
+
+
+def _help_requested(parser: TyperParser, argv: list[str]) -> bool:
+    help_names: set[str] = set()
+    def visit(current: TyperParser) -> None:
+        if current.add_help and current.prefix_chars:
+            prefix = current.prefix_chars[0]
+            help_names.update((f"{prefix}h", f"{prefix}{prefix}help"))
+        if current._subparsers:
+            for child in current._subparsers.parsers:
+                visit(child)
+    visit(parser)
+    for token in argv:
+        if token == "--":
+            return False
+        if token in help_names:
+            return True
+    return False
+
+
+def _version_requested(parser: TyperParser, argv: list[str]) -> bool:
+    version_names: set[str] = set()
+    def visit(current: TyperParser) -> None:
+        for spec in current._arguments:
+            if _action_name(spec) == "version":
+                version_names.update(spec.names)
+        if current._subparsers:
+            for child in current._subparsers.parsers:
+                visit(child)
+    visit(parser)
+    for token in argv:
+        if token == "--":
+            return False
+        if token.split("=", 1)[0] in version_names:
+            return True
+    return False
+
+
+def _is_option_token(token: str, option_map: dict[str, _Argument]) -> bool:
+    if token == "--":
+        return True
+    base = token.split("=", 1)[0]
+    if base in option_map:
+        return True
+    prefix_chars = {name[0] for name in option_map if name}
+    if token and token[0] in prefix_chars:
+        if token.startswith("-") and re.fullmatch(r"-\d+(?:\.\d+)?(?:[eE][-+]?\d+)?", token):
+            return False
+        return token not in {"-", "+"}
+    return False
+
+
+def _canonical_option(spec: _Argument, token: str) -> str:
+    if token.startswith("--") and token.split("=", 1)[0] in spec.names:
+        return token.split("=", 1)[0]
+    return next((name for name in spec.names if name.startswith("--")), spec.names[0])
+
+
+def _normalize_variable_options(parser: TyperParser, argv: list[str]) -> list[str]:
+    option_map = _option_map(parser)
+    if not option_map:
+        return argv
+    result: list[str] = []
+    index = 0
+    while index < len(argv):
+        token = argv[index]
+        base, separator, attached = token.partition("=")
+        spec = option_map.get(base)
+        if spec is None:
+            result.append(token)
+            index += 1
+            continue
+        nargs = spec.nargs
+        action = _action_name(spec)
+        if nargs == "?":
+            if separator:
+                result.append(token)
+                index += 1
+                continue
+            next_token = argv[index + 1] if index + 1 < len(argv) else None
+            if next_token is None or _is_option_token(next_token, option_map):
+                const = spec.kwargs.get("const")
+                value = _OPTIONAL_NONE_VALUE if const is None else _OPTIONAL_CONST_VALUE
+                result.append(f"{_canonical_option(spec, token)}={value}")
+                index += 1
+                continue
+            result.append(token)
+            index += 1
+            continue
+        if nargs not in {"*", "+", 2}:
+            result.append(token)
+            index += 1
+            continue
+        option = _canonical_option(spec, token)
+        raw_values: list[str] = []
+        if separator:
+            raw_values.append(attached)
+        index += 1
+        while index < len(argv) and not _is_option_token(argv[index], option_map):
+            raw_values.append(argv[index])
+            index += 1
+            if nargs == 2 and len(raw_values) == 2:
+                break
+        if nargs == 2 and len(raw_values) != 2:
+            print(f"{parser.prog}: error: argument {option}: expected 2 values", file=sys.stderr)
+            raise SystemExit(2)
+        if nargs == "+" and not raw_values:
+            print(f"{parser.prog}: error: argument {option}: expected at least one value", file=sys.stderr)
+            raise SystemExit(2)
+        if not raw_values:
+            raw_values.append(_EMPTY_VALUE)
+        result.extend(f"{option}={value}" for value in raw_values)
+        result.append(f"{option}={_GROUP_SEPARATOR}")
+    return result
+
+
+__all__ = [
+    "ArgumentParser",
+    "ArgumentTypeError",
+    "ArgumentDefaultsHelpFormatter",
+    "BooleanOptionalAction",
+    "FileType",
+    "MutuallyExclusiveGroup",
+    "Namespace",
+    "REMAINDER",
+    "RawDescriptionHelpFormatter",
+    "RawTextHelpFormatter",
+    "SUPPRESS",
+    "TyperParser",
+]
