+#!/usr/bin/env python3
+"""Run regression checks for the Typer-backed root CLI compatibility adapter."""
+from __future__ import annotations
+
+from contextlib import redirect_stderr, redirect_stdout
+import importlib
+import io
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import types
+import unittest
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT))
+
+from tools.typer_cli import BooleanOptionalAction, TyperParser
+
+
+class TyperCliCompatibilityTests(unittest.TestCase):
+    def quiet_parse(self, parser: TyperParser, args: list[str]):
+        with redirect_stdout(io.StringIO()), redirect_stderr(io.StringIO()):
+            return parser.parse_args(args)
+
+    def test_single_command_converts_types_and_applies_action_defaults(self) -> None:
+        parser = TyperParser(prog="single")
+        parser.add_argument("source", type=Path)
+        parser.add_argument("--limit", type=int, default=4)
+        parser.add_argument("--enabled", action="store_true")
+        parser.add_argument("--quiet", action="store_false")
+        parser.add_argument("items", nargs="*")
+
+        namespace = self.quiet_parse(parser, ["src.txt", "--limit", "9", "--enabled", "a", "b"])
+
+        self.assertEqual(namespace.source, Path("src.txt"))
+        self.assertEqual(namespace.limit, 9)
+        self.assertTrue(namespace.enabled)
+        self.assertTrue(namespace.quiet)
+        self.assertEqual(namespace.items, ["a", "b"])
+
+    def test_subcommand_merges_defaults_and_arguments(self) -> None:
+        parser = TyperParser(prog="dispatch")
+        parser.add_argument("--verbose", action="store_true")
+        subparsers = parser.add_subparsers(dest="command", required=True)
+        convert = subparsers.add_parser("convert", help="Convert a file")
+        convert.add_argument("source", type=Path)
+        convert.add_argument("-o", "--output", type=Path, default=None)
+        convert.set_defaults(handler="convert-handler")
+
+        namespace = self.quiet_parse(parser, ["--verbose", "convert", "a.txt", "--output", "b.txt"])
+
+        self.assertEqual(namespace.command, "convert")
+        self.assertTrue(namespace.verbose)
+        self.assertEqual(namespace.source, Path("a.txt"))
+        self.assertEqual(namespace.output, Path("b.txt"))
+        self.assertEqual(namespace.handler, "convert-handler")
+
+    def test_variable_and_fixed_option_nargs_keep_argparse_shape(self) -> None:
+        parser = TyperParser(prog="nargs")
+        parser.add_argument("--labels", nargs="*")
+        parser.add_argument("--range", nargs=2, type=int)
+        parser.add_argument("tail", nargs="*")
+
+        namespace = self.quiet_parse(
+            parser,
+            ["--labels", "one", "two", "--labels", "last", "--range", "3", "8", "end"],
+        )
+
+        self.assertEqual(namespace.labels, ["last"])
+        self.assertEqual(namespace.range, [3, 8])
+        self.assertEqual(namespace.tail, ["end"])
+
+    def test_append_choices_and_boolean_optional(self) -> None:
+        parser = TyperParser(prog="actions")
+        parser.add_argument("--tag", action="append", type=int, default=[])
+        parser.add_argument("--mode", choices=("fast", "safe"), default="safe")
+        parser.add_argument("--feature", action=BooleanOptionalAction)
+
+        namespace = self.quiet_parse(parser, ["--tag", "2", "--tag", "5", "--mode", "fast", "--no-feature"])
+
+        self.assertEqual(namespace.tag, [2, 5])
+        self.assertEqual(namespace.mode, "fast")
+        self.assertFalse(namespace.feature)
+
+    def test_mutually_exclusive_and_parse_known_args(self) -> None:
+        parser = TyperParser(prog="known")
+        group = parser.add_mutually_exclusive_group(required=True)
+        group.add_argument("--left", action="store_true")
+        group.add_argument("--right", action="store_true")
+        parser.add_argument("--value", type=int)
+
+        with redirect_stdout(io.StringIO()), redirect_stderr(io.StringIO()):
+            namespace, unknown = parser.parse_known_args(
+                ["--right", "--value", "7", "--other", "x"]
+            )
+        self.assertTrue(namespace.right)
+        self.assertEqual(namespace.value, 7)
+        self.assertEqual(unknown, ["--other", "x"])
+
+        with redirect_stdout(io.StringIO()), redirect_stderr(io.StringIO()):
+            with self.assertRaises(SystemExit) as caught:
+                parser.parse_args(["--left", "--right"])
+        self.assertEqual(caught.exception.code, 2)
+
+    def test_help_and_version_exit_successfully(self) -> None:
+        parser = TyperParser(prog="versioned")
+        parser.add_argument("--version", action="version", version="versioned 1.0")
+        with redirect_stdout(io.StringIO()) as output, redirect_stderr(io.StringIO()):
+            with self.assertRaises(SystemExit) as caught:
+                parser.parse_args(["--version"])
+        self.assertEqual(caught.exception.code, 0)
+        self.assertIn("versioned 1.0", output.getvalue())
+
+        with redirect_stdout(io.StringIO()) as help_output, redirect_stderr(io.StringIO()):
+            with self.assertRaises(SystemExit) as help_exit:
+                parser.parse_args(["--help"])
+        self.assertEqual(help_exit.exception.code, 0)
+        self.assertIn("Usage:", help_output.getvalue())
+
+    def test_non_dash_prefix_option(self) -> None:
+        parser = TyperParser(prog="prefix", prefix_chars="+-")
+        parser.add_argument("+append", dest="append", action="store_true")
+        self.assertTrue(self.quiet_parse(parser, ["+append"]).append)
+
+    def test_intermixed_arguments_and_options(self) -> None:
+        parser = TyperParser(prog="intermixed")
+        parser.add_argument("inputs", nargs="*")
+        parser.add_argument("--dry-run", action="store_true")
+
+        namespace = parser.parse_intermixed_args(["first.txt", "--dry-run", "second.txt"])
+
+        self.assertEqual(namespace.inputs, ["first.txt", "second.txt"])
+        self.assertTrue(namespace.dry_run)
+
+    def test_generated_unified_dispatcher_uses_typer(self) -> None:
+        fake_dh = types.ModuleType("dh")
+        fake_dh.unique_path = lambda path: path
+        old_dh = sys.modules.get("dh")
+        sys.modules["dh"] = fake_dh
+        try:
+            generator = importlib.import_module("generate_unified")
+        finally:
+            if old_dh is None:
+                sys.modules.pop("dh", None)
+            else:
+                sys.modules["dh"] = old_dh
+
+        with tempfile.TemporaryDirectory() as temp_dir:
+            folder = Path(temp_dir) / "sample_tools"
+            folder.mkdir()
+            source = folder / "toy.py"
+            source.write_text("import sys\nprint('TOOL-ARGS', sys.argv[1:])\n", encoding="utf-8")
+            generated_text = generator.build_unified(folder, [source])
+            self.assertNotIn("import argparse", generated_text)
+            compile(generated_text, "generated.py", "exec")
+            generated = folder / "generated.py"
+            generated.write_text(generated_text, encoding="utf-8")
+
+            listing = subprocess.run(
+                [sys.executable, str(generated), "--list"],
+                check=False,
+                capture_output=True,
+                text=True,
+            )
+            self.assertEqual(listing.returncode, 0, listing.stderr)
+            self.assertIn("toy", listing.stdout)
+
+            passthrough = subprocess.run(
+                [sys.executable, str(generated), "toy", "--custom"],
+                check=False,
+                capture_output=True,
+                text=True,
+            )
+            self.assertEqual(passthrough.returncode, 0, passthrough.stderr)
+            self.assertIn("TOOL-ARGS ['--custom']", passthrough.stdout)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
