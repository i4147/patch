+#!/usr/bin/env python3
+"""Remove the argparse shim that ``argparse2typer.py`` leaves behind.
+
+``argparse2typer.py`` produces two layouts.  The *inline* layout is already
+argparse free: ``args.foo`` is rewritten to the Typer parameter ``foo``.  The
+*fallback bridge* layout keeps a stand-in parser (``_Args`` / ``_ParserShim`` /
+``_STATE``) so that ``parser.parse_args()`` keeps working; the generated Typer
+command only stuffs the parsed values into ``_STATE``.
+
+This helper finishes that migration: the shim classes, ``_STATE`` and the
+``build_parser()``/``parse_args()`` helper are deleted, the function that
+consumed the namespace (usually ``main``) gets an explicit
+``args: SimpleNamespace`` parameter, and every Typer command passes a freshly
+built namespace straight to it::
+
+    @app.command(...)
+    def cli(binary: str = ...) -> None:
+        raise SystemExit(main(SimpleNamespace(binary=binary)))
+
+``parser.error(...)`` turns into ``raise typer.BadParameter(...)``, and files
+with more than one Typer command keep a small ``_Args`` namespace whose unknown
+attributes read as ``None`` so that options belonging to a *different*
+sub-command stay ``None`` instead of raising.
+
+Usage::
+
+    python3 tools/clean_typer_bridge.py FILE.py            # rewrite in place
+    python3 tools/clean_typer_bridge.py --check FILE.py    # report only
+
+The tool refuses to touch a file when the transformation cannot be proven safe
+(``--check`` prints why), so a half-converted file is never left behind.
+"""
+
+from __future__ import annotations
+
+import argparse
+import ast
+import io
+import re
+import sys
+import tokenize
+from dataclasses import dataclass, field
+from pathlib import Path
+
+SHIM_CLASSES = {"_ParserShim", "_Args"}
+STATE_NAME = "_STATE"
+COMMAND_DECORATORS = {"command", "callback"}
+HELPER_PREFIXES = ("parse_args", "build_parser", "build_arg_parser", "make_parser", "_build_parser", "_build_argument_parser")
+BLANK_LINES_RE = re.compile(r"\n{4,}")
+
+
+class Unsafe(Exception):
+    """Raised when the cleanup cannot be done without changing behaviour."""
+
+
+@dataclass
+class Edit:
+    """A text replacement keyed by character offsets."""
+
+    start: int
+    end: int
+    text: str
+    reason: str = ""
+
+
+@dataclass
+class Result:
+    """Outcome of a single-file cleanup."""
+
+    path: Path
+    changed: bool = False
+    warnings: list[str] = field(default_factory=list)
+
+
+def line_offsets(text: str) -> list[int]:
+    """Return the absolute offset of the first character of every line."""
+    offsets = [0]
+    for line in text.splitlines(keepends=True):
+        offsets.append(offsets[-1] + len(line))
+    return offsets
+
+
+def span(offsets: list[int], node: ast.AST) -> tuple[int, int]:
+    """Convert an AST node position into absolute ``(start, end)`` offsets."""
+    return offsets[node.lineno - 1] + node.col_offset, offsets[node.end_lineno - 1] + node.end_col_offset
+
+
+def statement_span(text: str, offsets: list[int], node: ast.stmt) -> tuple[int, int]:
+    """Return the span of a statement including trailing spaces and newline."""
+    start, end = span(offsets, node)
+    while start > 0 and text[start - 1] in " \t":
+        start -= 1
+    while end < len(text) and text[end] in " \t":
+        end += 1
+    if end < len(text) and text[end] == "\n":
+        end += 1
+    return start, end
+
+
+def loaded_names(node: ast.AST) -> set[str]:
+    """Return every identifier read inside a node."""
+    return {n.id for n in ast.walk(node) if isinstance(n, ast.Name) and isinstance(n.ctx, ast.Load)}
+
+
+def called_names(node: ast.AST) -> set[str]:
+    """Return the plain function names called inside a node."""
+    return {n.func.id for n in ast.walk(node) if isinstance(n, ast.Call) and isinstance(n.func, ast.Name)}
+
+
+def is_command(node) -> bool:
+    """Return whether a module-level function carries a Typer command decorator."""
+    for dec in node.decorator_list:
+        target = dec.func if isinstance(dec, ast.Call) else dec
+        if isinstance(target, ast.Attribute) and target.attr in COMMAND_DECORATORS:
+            return True
+        if isinstance(target, ast.Name) and target.id in COMMAND_DECORATORS:
+            return True
+    return False
+
+
+def find_helpers(tree: ast.Module) -> list[ast.FunctionDef]:
+    """Return module-level helpers that build the stand-in parser."""
+    helpers = []
+    for node in tree.body:
+        if not isinstance(node, ast.FunctionDef):
+            continue
+        if "_ParserShim" in {n.id for n in ast.walk(node) if isinstance(n, ast.Name)}:
+            helpers.append(node)
+        elif node.name.startswith(HELPER_PREFIXES) and any(
+            isinstance(n, ast.Call) and isinstance(n.func, ast.Attribute) and n.func.attr == "parse_args"
+            for n in ast.walk(node)
+        ):
+            helpers.append(node)
+    return helpers
+
+
+def enclosing(tree: ast.Module) -> dict[int, ast.FunctionDef]:
+    """Map ``id(node)`` of every statement to its enclosing function."""
+    owners: dict[int, ast.FunctionDef] = {}
+    for func in [n for n in ast.walk(tree) if isinstance(n, ast.FunctionDef)]:
+        for node in ast.walk(func):
+            if isinstance(node, ast.stmt):
+                owners.setdefault(id(node), func)
+    return owners
+
+
+def is_parse_args_call(node: ast.AST) -> bool:
+    """Return whether the node calls ``something.parse_args(...)``."""
+    return isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute) and node.func.attr == "parse_args"
+
+
+def collect_parser_statements(
+    tree: ast.Module, helper_names: set[str], skip_owners: set[int] | None = None
+) -> tuple[ast.FunctionDef, list[ast.stmt], list[str]]:
+    """Find the function that consumes the shim and the statements to delete."""
+    owners = enclosing(tree)
+    statements: list[ast.stmt] = []
+    consumers: list[ast.FunctionDef] = []
+    holders: list[str] = []
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Assign):
+            value = node.value
+        elif isinstance(node, ast.AnnAssign) and node.value is not None:
+            value = node.value
+        else:
+            continue
+        builds_helper = called_names(value) & (helper_names | {"_ParserShim"})
+        parses = any(is_parse_args_call(n) for n in ast.walk(value))
+        if not (builds_helper or parses):
+            continue
+        owner = owners.get(id(node))
+        if owner is None:
+            raise Unsafe("parser is built outside a function")
+        if skip_owners and id(owner) in skip_owners:
+            continue
+        statements.append(node)
+        consumers.append(owner)
+        if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
+            holders.append(node.targets[0].id)
+    unique_consumers = list({id(c): c for c in consumers}.values())
+    if not unique_consumers:
+        raise Unsafe("no parser construction found")
+    if len(unique_consumers) > 1:
+        raise Unsafe(f"parser statements live in several functions: {[c.name for c in unique_consumers]}")
+    if not statements:
+        raise Unsafe("no parser construction found")
+    return unique_consumers[0], statements, holders
+
+
+def is_parse_args_call_nested(node: ast.AST) -> bool:
+    """Return whether the node contains a ``x.parse_args(...)`` call."""
+    return any(is_parse_args_call(n) for n in ast.walk(node))
+
+
+def rewrite_signature(
+    text: str, offsets: list[int], func: ast.FunctionDef, args_name: str, ns_type: str
+) -> Edit:
+    """Give the consumer an ``args`` parameter, replacing an unused ``argv``."""
+    params = func.args
+    if params.vararg or params.kwonlyargs or params.kwarg or params.posonlyargs:
+        raise Unsafe(f"cannot rewrite the signature of {func.name}()")
+    names = [a.arg for a in params.args]
+    start = offsets[func.lineno - 1] + func.col_offset
+    open_paren = text.index("(", start)
+    close_paren = match_paren(text, open_paren)
+    body = text[open_paren + 1 : close_paren]
+    new_param = f"{args_name}: {ns_type}"
+    if not names:
+        new_body = new_param
+    elif names == ["argv"]:
+        new_body = new_param
+    else:
+        new_body = body.rstrip().rstrip(",") + f", {new_param}"
+    return Edit(open_paren + 1, close_paren, new_body, f"{func.name}() signature")
+
+
+def match_paren(text: str, open_index: int) -> int:
+    """Return the index of the closing parenthesis matching ``open_index``."""
+    depth = 0
+    for index in range(open_index, len(text)):
+        char = text[index]
+        if char == "(":
+            depth += 1
+        elif char == ")":
+            depth -= 1
+            if depth == 0:
+                return index
+    raise Unsafe("unbalanced parentheses in the command signature")
+
+
+def update_kwargs(node: ast.stmt) -> list[tuple[str, str]]:
+    """Return the ``key=value`` pairs of a ``_STATE.update(...)`` statement."""
+    call = node.value if isinstance(node, ast.Expr) else None
+    if call is None or not isinstance(call, ast.Call):
+        raise Unsafe("expected a call statement in the command body")
+    if not (isinstance(call.func, ast.Attribute) and call.func.attr == "update"):
+        raise Unsafe("expected _STATE.update(...) in the command body")
+    if call.args:
+        raise Unsafe("_STATE.update() is called with positional arguments")
+    return [(kw.arg, ast.unparse(kw.value)) for kw in call.keywords if kw.arg]
+
+
+def rewrite_command(
+    func: ast.FunctionDef, text: str, offsets: list[int], main_name: str, ns_type: str
+) -> list[Edit]:
+    """Replace ``_STATE.update(...)`` + ``_run()`` with a call to main."""
+    updates = []
+    tails = []
+    for node in func.body:
+        if isinstance(node, ast.Expr) and isinstance(node.value, ast.Call):
+            call = node.value
+            if isinstance(call.func, ast.Attribute) and call.func.attr == "update":
+                updates.append(node)
+            elif isinstance(call.func, ast.Name) and call.func.id in {"_run", main_name}:
+                tails.append((node, call))
+    if not updates and not tails:
+        return []
+    if len(updates) != 1:
+        raise Unsafe(f"{func.name}(): expected one state-update statement, found {len(updates)}")
+    if len(tails) != 1:
+        raise Unsafe(f"{func.name}(): expected one call to {main_name}(), found {len(tails)}")
+    kwargs = update_kwargs(updates[0])
+    tail_node, tail_call = tails[0]
+    if tail_call.args or tail_call.keywords:
+        raise Unsafe(f"{func.name}(): {main_name}() is called with arguments")
+    args_src = ", ".join(f"{key}={value}" for key, value in kwargs)
+    indent = " " * updates[0].col_offset
+    replacement = f"{indent}raise SystemExit({main_name}({ns_type}({args_src})))\n"
+    ustart, uend = statement_span(text, offsets, updates[0])
+    tstart, tend = statement_span(text, offsets, tail_node)
+    return [
+        Edit(ustart, uend, "", "drop state update"),
+        Edit(tstart, tend, replacement, f"{func.name}() passes a namespace to {main_name}()"),
+    ]
+
+
+def error_rewrites(text: str, tree: ast.Module, offsets: list[int], holders: list[str]) -> list[Edit]:
+    """Rewrite ``parser.error(...)`` / ``parser.print_help()`` calls."""
+    edits = []
+    for node in ast.walk(tree):
+        if not isinstance(node, ast.Call) or not isinstance(node.func, ast.Attribute):
+            continue
+        if not (isinstance(node.func.value, ast.Name) and node.func.value.id in holders):
+            continue
+        if node.func.attr == "error":
+            start, end = span(offsets, node)
+            inner = text[span(offsets, node)[0] + len(node.func.value.id) + 1 : end]
+            value = inner[len("error") :]
+            edits.append(Edit(start, end, f"raise typer.BadParameter{value}", "parser.error -> typer.BadParameter"))
+        elif node.func.attr in {"print_help", "print_usage"}:
+            start, end = span(offsets, node)
+            getter = "get_help" if node.func.attr == "print_help" else "get_usage"
+            edits.append(Edit(start, end, f"typer.echo(click.get_current_context().{getter}())", "parser help"))
+        elif node.func.attr in {"add_argument", "add_subparsers", "set_defaults", "parse_known_args"}:
+            raise Unsafe(f"parser.{node.func.attr}() survived the conversion")
+    return edits
+
+
+def strip_imports(text: str, tree: ast.Module, offsets: list[int], candidates: set[str]) -> list[Edit]:
+    """Drop imports of modules that nothing references any more."""
+    edits = []
+    used = {n.id for n in ast.walk(tree) if isinstance(n, ast.Name) and isinstance(n.ctx, ast.Load)}
+    used |= {n.attr for n in ast.walk(tree) if isinstance(n, ast.Attribute)}
+    used |= {n.value.id for n in ast.walk(tree) if isinstance(n, ast.Attribute) and isinstance(n.value, ast.Name)}
+    for node in tree.body:
+        if isinstance(node, ast.Import):
+            for alias in node.names:
+                base = alias.asname or alias.name.split(".")[0]
+                if base in candidates and base not in used:
+                    start, end = statement_span(text, offsets, node)
+                    edits.append(Edit(start, end, "", f"drop import {base}"))
+                    candidates.discard(base)
+                    break
+        elif isinstance(node, ast.ImportFrom):
+            for alias in node.names:
+                name = alias.asname or alias.name
+                if name in candidates and name not in used:
+                    start, end = statement_span(text, offsets, node)
+                    edits.append(Edit(start, end, "", f"drop from-import {name}"))
+                    candidates.discard(name)
+                    break
+    return edits
+
+
+def apply_edits(text: str, edits: list[Edit]) -> str:
+    """Apply non-overlapping edits, last position first."""
+    edits = sorted(edits, key=lambda e: (e.start, e.end), reverse=True)
+    limit = len(text) + 1
+    for edit in edits:
+        if edit.end > limit:
+            raise Unsafe(f"overlapping edits at {edit.start}:{edit.end} ({edit.reason})")
+        text = text[: edit.start] + edit.text + text[edit.end :]
+        limit = edit.start
+    return text
+
+
+def cleanup(text: str, path: Path) -> tuple[str, Result]:
+    """Remove the argparse shim from ``text`` and return the new source."""
+    result = Result(path=path)
+    if "_ParserShim" not in text:
+        return text, result
+    tree = ast.parse(text)
+    offsets = line_offsets(text)
+
+    helpers = find_helpers(tree)
+    if not helpers:
+        # Sub-command CLIs that dispatch through ``args.func(args)`` lose their
+        # entry point: the converter turns each sub-command into a Typer command
+        # that only records the callback in ``_STATE``.
+        return cleanup_dispatch(text, path)
+    if len(helpers) != 1:
+        raise Unsafe(f"expected exactly one shim builder, found {[h.name for h in helpers]}")
+    helper = helpers[0]
+    try:
+        # Statements that *build* the stand-in parser live in the helper itself;
+        # only the statements in its caller matter.
+        consumer, statements, holders = collect_parser_statements(tree, {helper.name}, {id(helper)})
+    except Unsafe:
+        # The shim is built inside the very function that consumes it.
+        consumer, statements, holders = collect_parser_statements(tree, {helper.name})
+
+    # The parser holder (``parser = build_parser()``) is the object the
+    # ``.parse_args()`` call hangs off; every other assigned name holds the
+    # parsed namespace (``args = parser.parse_args(argv)``).
+    receivers = {
+        n.func.value.id
+        for stmt in statements
+        for n in ast.walk(stmt)
+        if isinstance(n, ast.Call) and isinstance(n.func, ast.Attribute) and isinstance(n.func.value, ast.Name)
+    }
+    namespace_names = [
+        stmt.targets[0].id
+        for stmt in statements
+        if isinstance(stmt, ast.Assign)
+        and len(stmt.targets) == 1
+        and isinstance(stmt.targets[0], ast.Name)
+        and stmt.targets[0].id not in receivers
+    ]
+    if len(namespace_names) != 1:
+        raise Unsafe(f"could not identify the namespace variable (found {namespace_names})")
+    args_name = namespace_names[0]
+
+    cmds = [n for n in tree.body if isinstance(n, ast.FunctionDef) and is_command(n)]
+    if not cmds:
+        raise Unsafe("no Typer command functions found")
+    multi = len(cmds) > 1
+    ns_type = "_Args" if multi else "SimpleNamespace"
+
+    edits: list[Edit] = []
+    for stmt in statements:
+        start, end = statement_span(text, offsets, stmt)
+        edits.append(Edit(start, end, "", "drop shim parser statements"))
+    edits.append(rewrite_signature(text, offsets, consumer, args_name, ns_type))
+    for cmd in cmds:
+        edits.extend(rewrite_command(cmd, text, offsets, consumer.name, ns_type))
+    edits.extend(error_rewrites(text, tree, offsets, holders))
+
+    for node in tree.body:
+        if isinstance(node, ast.ClassDef) and node.name in SHIM_CLASSES:
+            if node.name == "_Args" and multi:
+                continue
+            start, end = statement_span(text, offsets, node)
+            edits.append(Edit(start, end, "", f"drop class {node.name}"))
+        elif isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name) and node.target.id == STATE_NAME:
+            start, end = statement_span(text, offsets, node)
+            edits.append(Edit(start, end, "", "drop _STATE"))
+        elif isinstance(node, ast.Assign) and any(isinstance(t, ast.Name) and t.id == STATE_NAME for t in node.targets):
+            start, end = statement_span(text, offsets, node)
+            edits.append(Edit(start, end, "", "drop _STATE"))
+        elif node is helper and node is not consumer:
+            start, end = statement_span(text, offsets, node)
+            edits.append(Edit(start, end, "", f"drop {helper.name}"))
+
+    runner = next((n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == "_run"), None)
+    if runner is not None and is_trivial_runner(runner, consumer.name):
+        if any(
+            isinstance(n, ast.Name) and n.id == "_run" and isinstance(n.ctx, ast.Load) for n in ast.walk(tree)
+        ) and len(cmds) > 1:
+            pass
+        start, end = statement_span(text, offsets, runner)
+        edits.append(Edit(start, end, "", "drop _run wrapper"))
+
+    # ``args: argparse.Namespace`` annotations stay behind after the parser is
+    # gone; they describe exactly what ``SimpleNamespace`` now holds.
+    first_pass = apply_edits(text, edits)
+    first_pass = first_pass.replace("argparse.Namespace", "SimpleNamespace")
+    # argparse's ``type=`` validators raise ``ArgumentTypeError``; Typer's
+    # equivalent (click) is ``BadParameter``.
+    first_pass = first_pass.replace("argparse.ArgumentTypeError", "typer.BadParameter")
+    first_pass = ensure_import(first_pass, "SimpleNamespace", "from types import SimpleNamespace")
+    second_tree = ast.parse(first_pass)
+    second_offsets = line_offsets(first_pass)
+    second_pass = apply_edits(first_pass, strip_imports(first_pass, second_tree, second_offsets, {"argparse", "click"}))
+    leftover = argparse_references(second_pass)
+    if leftover:
+        raise Unsafe(f"references to argparse remain: {sorted(leftover)[:4]}")
+
+    new_text = BLANK_LINES_RE.sub("\n\n\n", second_pass).rstrip("\n") + "\n"
+    removed = {"_ParserShim", STATE_NAME} | (set() if multi else {"_Args"})
+    if helper is not consumer:
+        removed.add(helper.name)
+    validate(new_text, removed=removed)
+    if multi and "class _Args" not in new_text:
+        raise Unsafe("multi-command file lost its _Args namespace")
+    result.changed = True
+    return new_text, result
+
+
+def cleanup_dispatch(text: str, path: Path) -> tuple[str, Result]:
+    """Finish a converter output that dispatched through ``args.func(args)``."""
+    result = Result(path=path)
+    tree = ast.parse(text)
+    offsets = line_offsets(text)
+    cmds = [n for n in tree.body if isinstance(n, ast.FunctionDef) and is_command(n)]
+    if not cmds:
+        raise Unsafe("no Typer command functions found")
+
+    edits: list[Edit] = []
+    for cmd in cmds:
+        updates = [
+            n
+            for n in cmd.body
+            if isinstance(n, ast.Expr)
+            and isinstance(n.value, ast.Call)
+            and isinstance(n.value.func, ast.Attribute)
+            and n.value.func.attr == "update"
+        ]
+        tails = [
+            n
+            for n in cmd.body
+            if isinstance(n, ast.Expr) and isinstance(n.value, ast.Call) and isinstance(n.value.func, ast.Name)
+            and n.value.func.id in {"_run", "main"}
+        ]
+        if len(updates) != 1 or len(tails) != 1:
+            raise Unsafe(f"{cmd.name}(): expected one state update and one dispatch call")
+        kwargs = update_kwargs(updates[0])
+        targets = [value for key, value in kwargs if key == "func"]
+        if len(targets) != 1:
+            raise Unsafe(f"{cmd.name}(): state has no 'func' callback")
+        rest = ", ".join(f"{key}={value}" for key, value in kwargs if key != "func")
+        indent = " " * updates[0].col_offset
+        edit_u = statement_span(text, offsets, updates[0])
+        edit_t = statement_span(text, offsets, tails[0])
+        edits.append(Edit(edit_u[0], edit_u[1], "", "drop state update"))
+        edits.append(
+            Edit(edit_t[0], edit_t[1], f"{indent}raise SystemExit({targets[0]}(_Args({rest})))\n", "call the sub-command")
+        )
+        if any(key == "func" for key in (k for k, _v in kwargs)):
+            pass
+
+    for node in tree.body:
+        if isinstance(node, ast.ClassDef) and node.name == "_ParserShim":
+            start, end = statement_span(text, offsets, node)
+            edits.append(Edit(start, end, "", "drop _ParserShim"))
+        elif isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name) and node.target.id == STATE_NAME:
+            start, end = statement_span(text, offsets, node)
+            edits.append(Edit(start, end, "", "drop _STATE"))
+        elif isinstance(node, ast.Assign) and any(isinstance(t, ast.Name) and t.id == STATE_NAME for t in node.targets):
+            start, end = statement_span(text, offsets, node)
+            edits.append(Edit(start, end, "", "drop _STATE"))
+        elif isinstance(node, ast.FunctionDef) and node.name == "_run":
+            if len(node.body) == 1 and isinstance(node.body[0], ast.Raise):
+                start, end = statement_span(text, offsets, node)
+                edits.append(Edit(start, end, "", "drop _run wrapper"))
+            else:
+                raise Unsafe("_run() does more than raise SystemExit()")
+
+    first_pass = apply_edits(text, edits).replace("argparse.Namespace", "SimpleNamespace")
+    first_pass = first_pass.replace("argparse.ArgumentTypeError", "typer.BadParameter")
+    first_pass = ensure_import(first_pass, "SimpleNamespace", "from types import SimpleNamespace")
+    second_tree = ast.parse(first_pass)
+    second_pass = apply_edits(
+        first_pass, strip_imports(first_pass, second_tree, line_offsets(first_pass), {"argparse", "click"})
+    )
+    leftover = argparse_references(second_pass)
+    if leftover:
+        raise Unsafe(f"references to argparse remain: {sorted(leftover)[:4]}")
+    new_text = BLANK_LINES_RE.sub("\n\n\n", second_pass).rstrip("\n") + "\n"
+    validate(new_text, removed={"_ParserShim", STATE_NAME})
+    if "class _Args" not in new_text:
+        raise Unsafe("multi-command file lost its _Args namespace")
+    result.changed = True
+    return new_text, result
+
+
+def is_trivial_runner(func: ast.FunctionDef, main_name: str) -> bool:
+    """Return whether the function is just ``raise SystemExit(main())``."""
+    if len(func.body) != 1 or not isinstance(func.body[0], ast.Raise):
+        return False
+    return main_name in called_names(func.body[0])
+
+
+def argparse_references(text: str) -> set[str]:
+    """Return the ``argparse.<name>`` references left, ignoring strings/comments."""
+    found = set()
+    try:
+        tokens = list(tokenize.generate_tokens(io.StringIO(text).readline))
+    except (tokenize.TokenError, IndentationError, SyntaxError):
+        return {"<unparsable>"}
+    for index, token in enumerate(tokens):
+        if token.type != tokenize.NAME or token.string != "argparse":
+            continue
+        if index + 2 < len(tokens) and tokens[index + 1].string == "." and tokens[index + 2].type == tokenize.NAME:
+            found.add(f"argparse.{tokens[index + 2].string}")
+        else:
+            found.add("argparse")
+    return found
+
+
+def ensure_import(text: str, name: str, statement: str) -> str:
+    """Add an import when ``name`` is used but never imported."""
+    tree = ast.parse(text)
+    imported = set()
+    for node in tree.body:
+        if isinstance(node, ast.Import):
+            imported |= {a.asname or a.name.split(".")[0] for a in node.names}
+        elif isinstance(node, ast.ImportFrom):
+            imported |= {a.asname or a.name for a in node.names}
+    if name in imported:
+        return text
+    used = {n.id for n in ast.walk(tree) if isinstance(n, ast.Name) and isinstance(n.ctx, ast.Load)}
+    if name not in used:
+        return text
+    offsets = line_offsets(text)
+    import_nodes = [n for n in tree.body if isinstance(n, (ast.Import, ast.ImportFrom))]
+    if not import_nodes:
+        raise Unsafe("cannot add an import to a file without imports")
+    anchor = import_nodes[-1]
+    _start, end = statement_span(text, offsets, anchor)
+    return text[:end] + statement + "\n" + text[end:]
+
+
+def validate(text: str, removed: set[str]) -> None:
+    """Re-parse the result and make sure nothing references what was deleted."""
+    tree = ast.parse(text)
+    names = {n.id for n in ast.walk(tree) if isinstance(n, ast.Name)}
+    leftovers = names & removed
+    if leftovers:
+        raise Unsafe(f"references to removed names remain: {sorted(leftovers)}")
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Attribute) and isinstance(node.value, ast.Name) and node.value.id in removed:
+            raise Unsafe(f"attribute access on removed name {node.value.id}")
+
+
+def main(argv: list[str] | None = None) -> int:
+    """Rewrite the given files, or report what would change."""
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("paths", nargs="+", type=Path)
+    parser.add_argument("--check", action="store_true", help="report only, do not write")
+    args = parser.parse_args(argv)
+
+    status = 0
+    for path in args.paths:
+        text = path.read_text(encoding="utf-8")
+        try:
+            new_text, result = cleanup(text, path)
+        except (Unsafe, SyntaxError) as exc:
+            print(f"SKIP {path}: {exc}")
+            status = 1
+            continue
+        if not result.changed:
+            print(f"OK   {path}: no argparse shim")
+            continue
+        compile(new_text, str(path), "exec")
+        if args.check:
+            print(f"WOULD {path}")
+            continue
+        path.write_text(new_text, encoding="utf-8")
+        print(f"DONE {path}")
+    return status
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/migrate_argparse_to_typer.py b/tools/migrate_argparse_to_typer.py
new file mode 100644
index 0000000..f6c2b73
--- /dev/null
+++ b/tools/migrate_argparse_to_typer.py
@@ -0,0 +1,160 @@
+#!/usr/bin/env python3
+"""Migrate the repository's root scripts from argparse to Typer, in place.
+
+Pipeline per file:
+
+1. *normalise* - annotated parser/namespace assignments
+   (``p: argparse.ArgumentParser = argparse.ArgumentParser(...)``) are rewritten
+   to plain assignments so the converter can see them.
+2. *convert* - ``argparse2typer.convert()`` (the repository's own converter)
+   rewrites every ``add_argument()`` into a Typer parameter.
+3. *clean* - ``tools/clean_typer_bridge.py`` removes the fallback parser shim
+   that the converter leaves for the "bridge" layout.
+4. *verify* - the result must compile and must not mention ``argparse``.
+
+A file that fails any step is left untouched and reported, so partial output is
+never written.
+
+Usage::
+
+    python3 tools/migrate_argparse_to_typer.py                 # all root files
+    python3 tools/migrate_argparse_to_typer.py --check         # report only
+    python3 tools/migrate_argparse_to_typer.py zip_crack.py xtar.py
+"""
+
+from __future__ import annotations
+
+import argparse
+import ast
+import importlib.util
+import re
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parent
+ROOT = TOOLS.parent
+ANN_ASSIGN_RE = re.compile(r"^(\s*)(\w+)\s*:\s*argparse\.[\w.\[\]|, ]+?(\s*=\s*)", re.MULTILINE)
+
+
+class Skip(Exception):
+    """Raised when a file cannot be migrated automatically."""
+
+
+@dataclass
+class Outcome:
+    """Result of migrating one file."""
+
+    path: Path
+    status: str
+    detail: str = ""
+
+
+def load_module(name: str, path: Path):
+    """Import a module from an explicit path."""
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise Skip(f"cannot import {path}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def load_tools():
+    """Import the repository converter and the bridge cleaner."""
+    converter = load_module("argparse2typer", ROOT / "argparse2typer.py")
+    cleaner = load_module("clean_typer_bridge", TOOLS / "clean_typer_bridge.py")
+    return converter, cleaner
+
+
+def normalise(text: str) -> str:
+    """Drop ``argparse.*`` annotations from parser/namespace assignments."""
+    return ANN_ASSIGN_RE.sub(r"\1\2\3", text)
+
+
+def uses_typer(text: str) -> bool:
+    """Return whether the file already drives its CLI with Typer."""
+    return re.search(r"^(import typer|from typer import)", text, re.MULTILINE) is not None
+
+
+def migrate_text(text: str, path: Path, converter, cleaner) -> tuple[str, list[str]]:
+    """Convert one file's source text to Typer and strip the fallback shim."""
+    if not re.search(r"^\s*import\s+argparse\b|^\s*from\s+argparse\b", text, re.MULTILINE):
+        raise Skip("does not import argparse")
+    if uses_typer(text):
+        raise Skip("already uses typer")
+    normalised = normalise(text)
+    try:
+        converted, warnings = converter.convert(normalised)
+    except converter.ConversionError as exc:
+        raise Skip(str(exc)) from exc
+    cleaned, result = cleaner.cleanup(converted, path)
+    if "_ParserShim" in cleaned:
+        raise Skip("argparse shim survived the cleanup")
+    if re.search(r"^\s*import\s+argparse\b|^\s*from\s+argparse\b", cleaned, re.MULTILINE):
+        raise Skip("argparse import survived the cleanup")
+    ast.parse(cleaned)
+    compile(cleaned, str(path), "exec")
+    return cleaned, warnings
+
+
+def _force_write(path: Path, text: str, converter) -> None:
+    """Write the raw converter output so a human can finish the migration."""
+    try:
+        converted, _warnings = converter.convert(normalise(text))
+        compile(converted, str(path), "exec")
+    except Exception as exc:  # noqa: BLE001 - report and leave the file alone
+        print(f"          (force write skipped: {type(exc).__name__}: {exc})")
+        return
+    path.write_text(converted, encoding="utf-8")
+    print(f"          (wrote raw converter output to {path.name})")
+
+
+def main(argv: list[str] | None = None) -> int:
+    """Run the migration for the given files (default: every root script)."""
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("paths", nargs="*", type=Path, help="files to migrate (default: all root scripts)")
+    parser.add_argument("--check", action="store_true", help="report only, do not write")
+    parser.add_argument(
+        "--force",
+        action="store_true",
+        help="write the converter output even when the shim cannot be removed (finish by hand)",
+    )
+    args = parser.parse_args(argv)
+
+    converter, cleaner = load_tools()
+    paths = args.paths or sorted(ROOT.glob("*.py"))
+    outcomes: list[Outcome] = []
+    for path in paths:
+        path = path if path.is_absolute() else ROOT / path
+        text = path.read_text(encoding="utf-8")
+        try:
+            new_text, warnings = migrate_text(text, path, converter, cleaner)
+        except Skip as exc:
+            outcomes.append(Outcome(path, "skipped", str(exc)))
+            continue
+        except Exception as exc:  # converter or cleaner refused: needs a human
+            outcomes.append(Outcome(path, "manual", f"{type(exc).__name__}: {exc}"))
+            if args.force and not args.check:
+                _force_write(path, text, converter)
+            continue
+        if new_text == text:
+            outcomes.append(Outcome(path, "unchanged", "converter produced identical source"))
+            continue
+        if not args.check:
+            path.write_text(new_text, encoding="utf-8")
+        note = "; ".join(warnings[:2]) if warnings else ""
+        outcomes.append(Outcome(path, "would-migrate" if args.check else "migrated", note))
+
+    counts: dict[str, int] = {}
+    for outcome in outcomes:
+        counts[outcome.status] = counts.get(outcome.status, 0) + 1
+        if outcome.status in {"skipped", "unchanged", "manual"}:
+            print(f"{outcome.status:>9} {outcome.path.name}: {outcome.detail}")
+    print("\n" + ", ".join(f"{count} {status}" for status, count in sorted(counts.items())))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
