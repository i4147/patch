new file mode 100644
index 0000000..12b5ccf
--- /dev/null
+++ b/tools/smoke_test_cli.py
@@ -0,0 +1,166 @@
+#!/usr/bin/env python3
+"""Create a throwaway ``dh`` stub and run ``--help`` for every root script.
+
+``dh`` is the Termux helper module that most scripts import, but it is not part
+of this repository, so importing those scripts fails here.  This helper writes a
+minimal stand-in into a temporary directory, puts it first on ``PYTHONPATH`` and
+runs each script with ``--help`` so the migrated command-line interface is at
+least exercised once.
+
+Usage::
+
+    python3 tools/smoke_test_cli.py            # every root script
+    python3 tools/smoke_test_cli.py zip_crack.py xtar.py
+"""
+
+from __future__ import annotations
+
+import argparse
+import os
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+
+DH_STUB = '''"""Minimal stand-in for the Termux ``dh`` helper module (smoke tests only)."""
+
+from __future__ import annotations
+
+import shutil
+import stat
+import subprocess
+import sys
+from pathlib import Path
+
+MAX_WORKERS = 4
+SKIP_DIRS = {".git", "__pycache__", "node_modules", ".venv", "build", "dist"}
+
+
+def cprint(*args, **kwargs):
+    """Print with colour stripped (stub)."""
+    print(*args, **kwargs)
+
+
+def gsz(paths):
+    """Return the byte size of a file, or the summed size of an iterable of paths."""
+    if isinstance(paths, (str, bytes, Path)):
+        try:
+            return Path(paths).stat().st_size
+        except OSError:
+            return 0
+    return sum(gsz(path) for path in paths)
+
+
+def fsz(size):
+    """Format *size* bytes as a human readable string."""
+    value = float(size)
+    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
+        if value < 1024:
+            return f"{value:.1f} {unit}"
+        value /= 1024
+    return f"{value:.1f} PiB"
+
+
+def dsz(path):
+    """Return the total size of a directory tree."""
+    root = Path(path)
+    return sum(p.stat().st_size for p in root.rglob("*") if p.is_file())
+
+
+def get_files(directory, ext=None):
+    """Return files under *directory*, optionally filtered by extension."""
+    root = Path(directory)
+    files = [p for p in root.rglob("*") if p.is_file()]
+    if ext:
+        wanted = {e.lower() for e in ext}
+        files = [p for p in files if p.suffix.lower() in wanted]
+    return files
+
+
+def get_pyfiles(directory):
+    """Return every Python file under *directory*."""
+    return [p for p in Path(directory).rglob("*.py") if p.is_file()]
+
+
+def mpf(func, items, method="map", **kwargs):
+    """Apply *func* to every item (serial stub)."""
+    return [func(item) for item in items]
+
+
+def rrs(path, before, after):
+    """Report a size reduction (stub)."""
+    return before - after
+
+
+def runcmd(cmd, check=False, show_output=False, **kwargs):
+    """Run a command and return ``(returncode, stdout, stderr)``."""
+    proc = subprocess.run(cmd, capture_output=True, text=True, check=False, **kwargs)
+    if show_output:
+        sys.stdout.write(proc.stdout)
+        sys.stderr.write(proc.stderr)
+    return proc.returncode, proc.stdout, proc.stderr
+'''
+
+
+def run(path: Path, env: dict[str, str], timeout: int = 60) -> tuple[int, str]:
+    """Run one script with ``--help`` and return its exit code and output."""
+    try:
+        proc = subprocess.run(
+            [sys.executable, str(path), "--help"],
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+            env=env,
+            cwd=str(ROOT),
+        )
+    except subprocess.TimeoutExpired:
+        return 124, "timeout"
+    return proc.returncode, (proc.stdout or "") + (proc.stderr or "")
+
+
+def classify(output: str) -> str:
+    """Classify a smoke-test failure by its first traceback line."""
+    for line in reversed(output.strip().splitlines()):
+        if line.startswith(("ModuleNotFoundError", "ImportError")):
+            return "missing dependency"
+        if line.startswith(("SyntaxError", "IndentationError", "TabError")):
+            return "syntax error"
+        if line.startswith(("NameError", "AttributeError", "TypeError", "ValueError", "KeyError")):
+            return "MIGRATION BUG"
+    if "Traceback" in output:
+        return "runtime error"
+    return "ok"
+
+
+def main(argv: list[str] | None = None) -> int:
+    """Run ``--help`` for the given scripts under a temporary ``dh`` stub."""
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("paths", nargs="*", type=Path)
+    parser.add_argument("--show-ok", action="store_true", help="also print the scripts that worked")
+    args = parser.parse_args(argv)
+
+    paths = args.paths or sorted(ROOT.glob("*.py"))
+    with tempfile.TemporaryDirectory() as tmp:
+        stub = Path(tmp) / "dh.py"
+        stub.write_text(DH_STUB, encoding="utf-8")
+        env = {**os.environ, "PYTHONPATH": tmp, "NO_COLOR": "1", "TERM": "dumb"}
+        results: dict[str, int] = {}
+        bugs = 0
+        for path in paths:
+            code, output = run(path if path.is_absolute() else ROOT / path, env)
+            verdict = "ok" if code == 0 else classify(output)
+            results[verdict] = results.get(verdict, 0) + 1
+            if verdict == "MIGRATION BUG":
+                bugs += 1
+            if verdict != "ok" or args.show_ok:
+                detail = "" if verdict == "ok" else f" [{verdict}] {output.strip().splitlines()[-1][:100]}"
+                print(f"{code:>3} {path.name}{detail}")
+        print()
+        print(", ".join(f"{count} {verdict}" for verdict, count in sorted(results.items())))
+        return 1 if bugs else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
