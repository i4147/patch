+def run_command(name: str, func: Callable[[Library, object], int], **options: object) -> None:
+    """Open the library and hand a parsed-options namespace to ``func``."""
+    db_path: Path = (_CLI.get("db") or default_db_path()).expanduser()  # type: ignore[union-attr]
+    args = SimpleNamespace(command=name, func=func, db=_CLI.get("db"), **options)
+    try:
+        with contextlib.closing(Library(db_path)) as lib:
+            raise typer.Exit(int(func(lib, args)))
+    except BrokenPipeError:  # e.g. ``rlater ls | head``
+        with contextlib.suppress(Exception):
+            os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
+        raise typer.Exit(141) from None
+    except KeyboardInterrupt:
+        raise typer.Exit(130) from None
+    except sqlite3.Error as exc:
+        die(f"database error: {exc}")
