+@app.callback()
+def _root(
+    db: Annotated[
+        Path | None, typer.Option("--db", help="database file (default: $RLATER_DB or XDG data dir)")
+    ] = None,
+    version: Annotated[
+        bool,
+        typer.Option("--version", callback=_version_callback, is_eager=True, help="show the version and exit"),
+    ] = False,
+) -> None:
+    """Local-first read-it-later: save pages to SQLite, read them in your terminal."""
+    _CLI["db"] = db
+
